# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webisdom_crm
DB_USER=root
DB_PASSWORD=replace_with_hostinger_database_password

# Application Timezone
APP_TIMEZONE=Asia/Kolkata
CRM_TIMEZONE=Asia/Kolkata

# Google Calendar / Meet (optional; configure OAuth in Google Cloud)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN.com/crm/admin/google_callback.php
GOOGLE_CALENDAR_ID=primary

# Mail / SMTP Configuration (Fallback only - CRM uses per-user SMTP by default)
CRM_SMTP_ALLOW_GLOBAL_FALLBACK=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@webisdom.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@webisdom.com
SMTP_FROM_NAME=Webisdom CRM

# Per-User SMTP Encryption Key (AES-256-GCM, 32 bytes hex-encoded, 64 characters)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
SMTP_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# AI Research & Outreach Drafting Agent
# Supported: gemini (with live Google Search grounding) or autonomous engine fallback
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# API Security
CRM_LEADS_API_KEY=your_random_secret_api_key_here

